{
  "manifest_version": 3,
  "name": "CloudFlare Purge Plugin",
  "short_name": "CloudFlare Purge",
  "description": "This extension can purge the CloudFlare cache for the current page of your CloudFlare enabled website",
  "version": "1.9.0",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": { "19": "icon.png",
            "48": "icon48.png"
  },
  "action": {
   "default_icon": "icon.png",
   "default_popup": "popup.html"
  },
  "background": {
    "page": "background.html"
  },
  "permissions": [
   "activeTab",
   "storage"
   ],
   "host_permissions": [
      "http://*/*",
      "https://*/*"
   ],
   "browser_specific_settings": {
    "gecko": {
      "id": "{0a40b0aa-001b-41c9-a3d7-7f4c4fe77025}",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo"]
      }
    }
  }
}

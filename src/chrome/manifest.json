{
  "manifest_version": 3,
  "name": "CloudFlare Advanced Purge Plugin",
  "short_name": "CloudFlare Advanced Purge",
  "description": "This extension can purge the CloudFlare cache for the current page, for a domain or for a tag of your CloudFlare enabled website",
  "version": "1.10.3",
  "options_page": "options.html",
  "icons": { "19": "icon.png",
            "48": "icon48.png" 
  },
  "action": {
   "default_icon": "icon.png",
   "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
   "activeTab",
   "webRequest",
   "storage"
   ],
   "host_permissions": [
      "http://*/*",
      "https://*/*"
   ]
}